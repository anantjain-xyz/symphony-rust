{
  "version": 1,
  "sourceRoot": "src",
  "generatedOwners": ["src/bindings.ts"],
  "previewOwners": ["src/main.tsx", "src/preview/runtime.ts"],
  "runtimeSelectionOwner": "src/App.tsx",
  "tauriImportOwners": {
    "@tauri-apps/api/app": ["src/desktop/shell.ts"],
    "@tauri-apps/api/core": ["src/desktop/commands.ts", "src/desktop/runtime.ts"],
    "@tauri-apps/api/event": ["src/desktop/events.ts"],
    "@tauri-apps/plugin-opener": ["src/desktop/shell.ts"],
    "@tauri-apps/plugin-process": ["src/desktop/updater.ts"],
    "@tauri-apps/plugin-updater": ["src/desktop/updater.ts"]
  },
  "commandOwner": "src/desktop/commands.ts",
  "commands": [
    "apply_retro_workflow",
    "delete_retro",
    "get_default_prompt",
    "get_default_skills",
    "get_linear_viewer",
    "get_overview",
    "get_repo_workflow_status",
    "get_retro_detail",
    "get_retro_status",
    "get_run_detail",
    "get_skills_install_status",
    "get_skills_status",
    "get_worker_status",
    "get_workflow_transfer_status",
    "has_in_progress_retro_batches",
    "install_skills",
    "list_issues",
    "list_retros",
    "list_runs",
    "load_settings",
    "remove_linear_api_key",
    "save_settings",
    "set_retro_suggestion_decision",
    "start_retro",
    "start_retro_prs",
    "start_worker",
    "stop_run",
    "stop_worker",
    "test_tracker_connection",
    "transfer_workflow_to_repo",
    "trigger_retry_now",
    "validate_settings"
  ],
  "eventOwner": "src/desktop/events.ts",
  "events": ["agent_event", "db_changed", "rate_limit_changed"],
  "asyncInvariantTests": [
    {
      "id": "per-caller-settlement",
      "path": "src/dashboardRefreshCoordinator.test.ts",
      "marker": "settles a queued caller after its batch while later polling work runs"
    },
    {
      "id": "generation-suppression",
      "path": "src/dashboardRefreshCoordinator.test.ts",
      "marker": "keeps the active result authoritative until the queued follow-up starts"
    },
    {
      "id": "foreground-background-errors",
      "path": "src/dashboardRefreshCoordinator.test.ts",
      "marker": "suppresses background failures without suppressing requested failures"
    },
    {
      "id": "hidden-view-resume",
      "path": "src/pollController.test.ts",
      "marker": "pauses while hidden and resumes with exactly one immediate request"
    },
    {
      "id": "remounted-view-settlement",
      "path": "src/settingsValidationController.test.ts",
      "marker": "lets an authoritative validation settle after its feature unmounts"
    },
    {
      "id": "idempotent-listener-cleanup",
      "path": "src/desktop/events.test.ts",
      "marker": "cleans every listener exactly once"
    }
  ]
}
