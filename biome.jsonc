{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**/*.cjs",
      "**/*.css",
      "**/*.js",
      "**/*.json",
      "**/*.jsonc",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.ts",
      "**/*.tsx",
      "!!**/.cache",
      "!!**/coverage",
      "!!**/dist",
      "!!**/node_modules",
      "!!**/playwright-report",
      "!!**/target",
      "!!**/test-results",
      "!src/bindings.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "json": {
    "formatter": {
      "enabled": true
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            // Test queries and fixture maps assert presence immediately before use;
            // keeping those assertions makes failed setup abort at the use site.
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["src/themeBootstrap.test.tsx"],
      "linter": {
        "rules": {
          "security": {
            // This test intentionally evaluates the generated bootstrap script in
            // an isolated jsdom window; production sources retain noGlobalEval.
            "noGlobalEval": "off"
          }
        }
      }
    }
  ]
}
