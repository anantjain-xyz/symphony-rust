{
  "name": "symphony-rust",
  "private": true,
  "version": "0.1.17",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "test:boundaries": "node --test scripts/check-boundaries.node.mjs",
    "test:bundle": "node --test scripts/check-bundle-budget.node.mjs",
    "test:runtime-contracts": "cargo test -p symphony-agents native_backend_fixture_contracts && cargo test -p symphony-storage runtime_lifecycle_transition_matrix && cargo test -p symphony-worker runtime_boundary_contracts && cargo test -p symphony-worker runtime_lifecycle_transition_matrix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "tauri": "node scripts/tauri.mjs",
    "release:mac": "bash scripts/release-macos.sh",
    "release:publish": "bash scripts/publish-macos.sh"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@tanstack/react-virtual": "^3.14.6",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^26.1.0",
    "playwright": "1.61.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.5.2+sha512.71c631e382066efc25625d5cf029075de07b61b37f6e27350fbd84b1bda5864c8c1967adc280776b45c30a715c0359a3be08fef42d5bb09e2b99029979692916"
}
